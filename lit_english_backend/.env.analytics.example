# AI Analytics / Azure Cost Management
# One-time Azure setup: create a Microsoft Entra service principal and give it
# Cost Management Reader on the subscription used by LIT.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional alternative to subscription scope:
# AZURE_COST_SCOPE=subscriptions/<subscription-id>/resourceGroups/<resource-group>
AZURE_COST_API_VERSION=2026-06-01
ANALYTICS_COST_SYNC_HOURS=24
ANALYTICS_INITIAL_LOOKBACK_DAYS=90

# Groq model/pricing. Token usage is captured directly from the Groq response.
# These are public on-demand rates for GPT-OSS 120B and can be overridden if
# the model changes or Groq changes pricing.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_INPUT_USD_PER_MILLION=0.15
GROQ_OUTPUT_USD_PER_MILLION=0.60
